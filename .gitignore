################################################################################
# gman-skills .gitignore
################################################################################

# Session / scratch
.scratch/
!skills/*/evals/fixtures/**/.scratch/

# Playwright CLI snapshots (smoke test artifacts)
.playwright-cli/

# Eval / workspace
*-workspace/

# npx skills project-level install (we install globally, not in-repo)
.agents/
skills-lock.json

# .NET build artifacts
src/report-server/**/bin/
src/report-server/**/obj/
src/report-server/**/.vs/
src/**/*.user
src/**/TestResults/

# IDE
.vs/
