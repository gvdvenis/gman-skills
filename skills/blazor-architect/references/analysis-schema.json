{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "analysis",
  "description": "Orchestrator end-of-run summary, written to analysis.json in step 6 of blazor-architect.",
  "type": "object",
  "required": ["run_id", "final_status", "status_counts", "lane_outcomes", "review_outcome"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Run identifier, format run-YYYYMMDD-HHMM."
    },
    "final_status": {
      "type": "string",
      "enum": ["success", "partial", "blocked", "failed"],
      "description": "Worst lane status, by precedence failed > blocked > partial > success."
    },
    "status_counts": {
      "type": "object",
      "description": "Number of lanes per status.",
      "properties": {
        "success": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "failed":  { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "lane_outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["lane", "status"],
        "properties": {
          "lane":   { "type": "string", "description": "e.g. component-author" },
          "status": { "type": "string", "enum": ["success", "partial", "blocked", "failed", "failed_report_schema"] },
          "files":  { "type": "array", "items": { "type": "string" }, "description": "Files the lane created or changed." }
        }
      }
    },
    "review_outcome": {
      "type": "string",
      "enum": ["passed", "fixed", "review_unresolved", "skipped"],
      "description": "See references/review-loop-contract.md."
    },
    "review_findings": {
      "type": "array",
      "description": "Present only when review_outcome is review_unresolved.",
      "items": {
        "type": "object",
        "required": ["file", "severity", "description"],
        "properties": {
          "file":        { "type": "string" },
          "line_range":  { "type": "string", "description": "e.g. '42-57'. Omit when unknown." },
          "severity":    { "type": "string", "enum": ["error", "warning", "advisory"] },
          "description": { "type": "string" }
        }
      }
    },
    "follow_up_items": {
      "type": "array",
      "description": "Present when final_status is partial or blocked: what the user must do next.",
      "items": { "type": "string" }
    },
    "classifier_override": {
      "type": "object",
      "description": "Present when the route departs from references/routing-classifier.md.",
      "required": ["reason", "original_decision", "actual_decision"],
      "properties": {
        "reason": { "type": "string" },
        "original_decision": { "enum": ["inline", "delegate", "parallel"] },
        "actual_decision": { "enum": ["inline", "delegate", "parallel"] }
      }
    }
  }
}
